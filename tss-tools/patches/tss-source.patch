+func ParseSignatureRSHex(signature []byte) (string, string, error) {
+	if len(signature) != 64 {
+		return "", "", fmt.Errorf("expected 64-byte compact signature, got %d bytes", len(signature))
+	}
+	return hex.EncodeToString(signature[:32]), hex.EncodeToString(signature[32:]), nil
+}
