+func LoadEthereumPubkeyHexString(home, vault string) (string, error) {
+	passphrase, err := resolvePassphrase()
+	if err != nil {
+		return "", err
+	}
+
+	ecdsaPubKey, err := common.LoadEcdsaPubkey(home, vault, passphrase)
+	if err != nil {
+		return "", err
+	}
+	btcecPubKey := (*btcec.PublicKey)(ecdsaPubKey)
+	return hex.EncodeToString(btcecPubKey.SerializeUncompressed()[1:]), nil
+}
+
+func LoadEthereumAddress(home, vault string) (string, error) {
+	pubkeyHex, err := LoadEthereumPubkeyHexString(home, vault)
+	if err != nil {
+		return "", err
+	}
+	pubkeyBytes, err := hex.DecodeString(pubkeyHex)
+	if err != nil {
+		return "", err
+	}
+	return ethereumAddress(pubkeyBytes), nil
+}
+
+func resolvePassphrase() (string, error) {
+	if common.TssCfg.Password != "" {
+		return common.TssCfg.Password, nil
+	}
+	if envPassword := os.Getenv("TSS_PASSWORD"); envPassword != "" {
+		return envPassword, nil
+	}
+	if p, err := speakeasy.Ask("> Password to sign with this vault:"); err == nil {
+		return p, nil
+	} else {
+		return "", err
+	}
+}
