# URL of the coordinator server
COORDINATOR_URL=http://127.0.0.1:8000

# Liberdus collector API
COLLECTOR_HOST=http://127.0.0.1:3035

# Liberdus proxy/node
PROXY_SERVER_HOST=http://127.0.0.1:3030

# Native BNB TSS vault passwords, one per chain.
# Required for tss-init, tss-keygen, tss-verify, and tss-party startup validation.
# Replace 97 / 137 with your configured chain IDs.
BNB_TSS_PASSWORD_CHAIN_97=XXXXXX
# BNB_TSS_PASSWORD_CHAIN_137=XXXXXX

# Shared native keygen/regroup channel settings.
# Required for manual native keygen/regroup/sign commands unless passed via flags.
# BNB_TSS_CHANNEL_ID=
# BNB_TSS_CHANNEL_PASSWORD=

# Optional override used by long-lived tss-party signing to derive deterministic
# channel passwords. All parties must share the same value if you override it.
# SHARDUS_CRYPTO_HASH_KEY=

# Optional native TSS path overrides
# BNB_TSS_ROOT=
# BNB_TSS_BINARY=
# BNB_TSS_HOME_ROOT=
# BNB_TSS_VAULT_NAME=default
