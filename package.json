{
  "name": "tss-server",
  "version": "0.0.9",
  "description": "Liberdus Bridge TSS Server",
  "keywords": [
    "tss",
    "gg18",
    "mpc",
    "bridge",
    "blockchain"
  ],
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "start-observer": "npm run compile && node dist/observer/src/index.js",
    "dev-observer": "nodemon --watch observer/src --exec ts-node observer/src/index.ts",
    "test": "npm run compile && npm run test:tss-tools",
    "tss-party": "npm run compile && node dist/tss-party.js",
    "tss-build": "./tss-tools/build-tss.sh",
    "tss-init": "npm run compile && node dist/tss-tools/init.js",
    "tss-keygen": "npm run compile && node dist/tss-tools/keygen.js",
    "tss-regroup": "npm run compile && node dist/tss-tools/regroup.js",
    "tss-verify": "npm run compile && node dist/tss-tools/verify.js",
    "tss-sign-ethereum-tx": "npm run compile && node dist/tss-tools/sign-ethereum-tx.js",
    "test:tss-tools": "node tss-tools/lib/committeeTopology.test.js && node tss-tools/lib/channelId.test.js",
    "start-tss": "pm2 start ecosystem.config.js",
    "stop-tss": "pm2 stop ecosystem.config.js",
    "restart-tss": "pm2 restart ecosystem.config.js",
    "delete-tss": "pm2 delete ecosystem.config.js",
    "logs-tss": "pm2 logs",
    "status-tss": "pm2 status"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/readline-sync": "^1.4.8",
    "ethers": "^5.7.1",
    "nodemon": "^3.0.2",
    "pm2": "^5.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@shardus/crypto-utils": "^4.1.6",
    "axios": "^1.8.4",
    "better-sqlite3": "^9.4.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "readline-sync": "^1.4.10"
  }
}
